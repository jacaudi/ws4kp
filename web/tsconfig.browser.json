{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"strict": false,
		"skipLibCheck": true,
		"target": "esnext",
		"lib": ["dom", "esnext"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"types": []
	},
	"include": ["server/scripts/**/*.mjs", "server/scripts/**/*.js", "types/globals.d.ts"],
	"exclude": ["server/scripts/vendor/**", "server/scripts/custom*.*"]
}
