{
	"name": "ws4kp",
	"version": "7.5.0",
	"description": "A web-based simulation of the classic WeatherStar 4000 cable tv forecast hardware",
	"type": "module",
	"scripts": {
		"start": "echo \"The server is now Go: run 'task dev' or 'go run ./cmd/ws4kp' from the repo root\" && exit 1",
		"test:unit": "node --test \"tests/unit/*.test.mjs\"",
		"build:travelcities": "node datagenerators/travelcities.mjs",
		"build:regionalcities": "node datagenerators/regionalcities.mjs",
		"build:stations": "node datagenerators/stations.mjs",
		"build:css": "sass --style=compressed ./server/styles/scss/ws.scss ./server/styles/ws.min.css",
		"watch:css": "npm run build:css -- --watch",
		"build": "npx gulp buildDist",
		"dev:index": "gulp buildDevIndex",
		"dev:watch": "gulp watch",
		"lint": "npx eslint .",
		"lint:fix": "npx eslint --fix ."
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/netbymatt/ws4kp.git"
	},
	"author": "Matt Walsh",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/netbymatt/ws4kp/issues"
	},
	"homepage": "https://github.com/netbymatt/ws4kp#readme",
	"devDependencies": {
		"@eslint/config-helpers": "^0.7.0",
		"@eslint/js": "^10.0.0",
		"@zakj/no-sleep": "^0.13.6",
		"del": "^9.0.0",
		"dotenv": "^18.0.1",
		"ejs": "^7.0.0",
		"eslint": "^10.0.0",
		"eslint-config-airbnb-extended": "^3.1.1",
		"fancy-log": "^2.0.0",
		"globals": "^17.12.0",
		"gulp": "^5.0.0",
		"gulp-ejs": "^5.1.0",
		"gulp-html-minifier-terser": "^8.0.0",
		"gulp-rename": "^2.0.0",
		"gulp-sass": "^6.0.0",
		"luxon": "^3.0.0",
		"metar-taf-parser": "^9.0.0",
		"music-metadata": "^12.0.0",
		"p-limit": "^7.3.1",
		"proj4": "^2.22.0",
		"sass": "^1.54.0",
		"suncalc": "^2.0.2",
		"swiped-events": "^1.1.4",
		"webpack": "^5.99.9",
		"webpack-stream": "^7.0.0"
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": true,
		"unrs-resolver@1.12.2": true
	},
	"engines": {
		"node": ">=20"
	}
}
