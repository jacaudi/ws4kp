{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "security:minimumReleaseAgeNpm",
    "helpers:pinGitHubActionDigests"
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "fix",
  "semanticCommitScope": "deps",
  "packageRules": [
    {
      "description": "Vendored packages are copied into server/scripts/vendor/auto/ and served to the browser, so the lockfile bump alone leaves the shipped bundle stale. npm ci first: Renovate resolves lockfiles with --package-lock-only, so node_modules does not exist and updateVendor has nothing to copy from.",
      "matchPackageNames": [
        "luxon",
        "@zakj/no-sleep",
        "suncalc",
        "swiped-events",
        "metar-taf-parser"
      ],
      "postUpgradeTasks": {
        "commands": [
          "npm ci --ignore-scripts",
          "npx gulp updateVendor"
        ],
        "fileFilters": [
          "server/scripts/vendor/auto/**"
        ],
        "executionMode": "branch"
      }
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the bjw-s app-template Helm chart version pinned in docs/kubernetes.md",
      "managerFilePatterns": [
        "/^docs/kubernetes\\.md$/"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/bjw-s-labs/helm/app-template",
      "matchStrings": [
        "app-template --version (?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "app-template\\s+ref:\\s+tag: (?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ]
    }
  ]
}
